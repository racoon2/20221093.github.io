<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>판타지 SRPG 프로토타입</title>
<style>
:root{--bg:#f4efe4;--fg:#2b2418;--tile1:#cfd9b4;--tile2:#c2cea3;--wall:#8a8272;--mv:rgba(70,130,230,.45);--atk:rgba(220,60,60,.5);--panel:#e6dcc6;--btn:#5b3f8c;--btnfg:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1a24;--fg:#ece6d6;--tile1:#3b4a35;--tile2:#34422f;--wall:#55505e;--panel:#2a2733}}
:root[data-theme="dark"]{--bg:#1c1a24;--fg:#ece6d6;--tile1:#3b4a35;--tile2:#34422f;--wall:#55505e;--panel:#2a2733}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;-webkit-tap-highlight-color:transparent}
#app{max-width:480px;margin:0 auto;padding:10px}
h1{font-size:17px;margin:4px 0 8px;text-align:center}
#board{display:grid;grid-template-columns:repeat(8,1fr);gap:1px;background:var(--wall);border:2px solid var(--wall);border-radius:8px;overflow:hidden;touch-action:manipulation}
.t{aspect-ratio:1;position:relative;display:flex;align-items:center;justify-content:center;font-size:min(7.5vw,34px);user-select:none}
.t.a{background:var(--tile1)}.t.b{background:var(--tile2)}.t.w{background:var(--wall)}
.t.mv::after,.t.at::after{content:"";position:absolute;inset:0}
.t.mv::after{background:var(--mv)}.t.at::after{background:var(--atk)}
.t.sel{outline:3px solid #f0b400;outline-offset:-3px;z-index:1}
.u.done{opacity:.45;filter:grayscale(.8)}
.hp{position:absolute;left:10%;right:10%;bottom:3%;height:4px;background:#0006;border-radius:2px;overflow:hidden}
.hp i{display:block;height:100%;background:#4caf50}
.foe .hp i{background:#e53935}
.foe{background-image:linear-gradient(#e5393522,#e5393522)}
#info{background:var(--panel);border-radius:8px;padding:8px 10px;margin:8px 0;font-size:14px;min-height:42px;line-height:1.4}
#bar{display:flex;gap:8px}
button{flex:1;padding:12px;font-size:15px;border:0;border-radius:8px;background:var(--btn);color:var(--btnfg);font-weight:600}
button.s{background:var(--panel);color:var(--fg)}
#msg{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:#000a;z-index:9}
#msg div{background:var(--panel);padding:24px 32px;border-radius:12px;text-align:center;font-size:20px}
#msg button{margin-top:14px;width:100%}
#start{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#2a1f4d,#12101c);color:#f3ecd8;padding:env(safe-area-inset-top,0px) 20px env(safe-area-inset-bottom,0px)}
#start .box{width:100%;max-width:340px;text-align:center}
#start .logo{font-size:64px}
#start h2{font-size:28px;margin:6px 0 4px;letter-spacing:1px}
#start p{opacity:.75;margin:0 0 24px;font-size:14px}
#start button{margin:6px 0;width:100%;font-size:17px;padding:14px}
#start button.s{background:#ffffff1f;color:#f3ecd8}
#how{display:none;text-align:left;font-size:14px;line-height:1.6;background:#ffffff14;border-radius:10px;padding:12px 14px;margin-top:10px}
#story{position:fixed;inset:0;z-index:11;display:none;align-items:flex-end;justify-content:center;background:linear-gradient(180deg,#0b0a12,#241a3d);color:#f3ecd8;padding:20px 20px calc(24px + env(safe-area-inset-bottom,0px))}
#story .sb{width:100%;max-width:440px;text-align:center}
#se{font-size:72px;margin-bottom:12px}
#st{font-size:17px;line-height:1.7;min-height:96px;margin:0 0 16px}
#story button{width:100%;margin:5px 0;padding:14px;font-size:16px}
#story button.s{background:#ffffff1f;color:#f3ecd8}
#gacha{position:fixed;inset:0;z-index:12;display:none;overflow:auto;background:linear-gradient(160deg,#2a1f4d,#12101c);color:#f3ecd8;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(20px + env(safe-area-inset-bottom,0px))}
#gacha .box{max-width:400px;margin:0 auto;text-align:center}
#gacha h2{margin:4px 0}
#gm{font-size:18px;margin-bottom:10px}
#gacha button{width:100%;margin:6px 0;padding:14px;font-size:16px}
#gacha button.s{background:#ffffff1f;color:#f3ecd8}
#pr{min-height:92px;margin:8px 0;line-height:1.5}
.ph{font-size:13px;opacity:.75;margin:10px 0 6px}
#roster{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}
#roster .c{background:#ffffff14;border-radius:10px;padding:8px 2px;font-size:12px;line-height:1.5}
#roster .c b{display:block;font-size:28px}
#roster .c.on{outline:2px solid #f0b400}
.sp{image-rendering:pixelated;display:block}
.t .sp{width:70%}
#se .sp{width:110px;margin:0 auto}
#start .sp{width:96px;margin:0 auto}
#roster .sp{width:46px;margin:0 auto 2px}
#pr .sp{width:84px;margin:0 auto 4px}
.t .sp.tall{width:54%}
#se .sp.tall{width:88px}
#roster .sp.tall{width:34px}
#pr .sp.tall{width:64px}
#board{display:block;border:0;padding:0;line-height:0;border-radius:10px;background:radial-gradient(circle at 50% 30%,#3a3250,#14121c)}
#board canvas{display:block;width:100%}
#bar button{padding:12px 4px;font-size:14px}
#hub{position:fixed;inset:0;z-index:12;display:none;overflow:auto;background:linear-gradient(160deg,#1f3a3d,#12101c);color:#f3ecd8;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(20px + env(safe-area-inset-bottom,0px))}
#hub .box{max-width:400px;margin:0 auto;text-align:center}
#hub button{width:100%;margin:6px 0;padding:14px;font-size:15px}
#hub button.s{background:#ffffff1f;color:#f3ecd8}
#hub button:disabled{opacity:.45}
#hub small{opacity:.75}
#board{background:radial-gradient(circle at 50% 30%,#2a3342,#0c0f16)}
#board{background:radial-gradient(circle at 50% 30%,#3a2c52,#0d0914)}
#hub{padding:0;overflow:hidden;background:#050304}
#hub .box{display:none}
#hbox{position:absolute;inset:0}
#hbox canvas{display:block;width:100%;height:100%}
#htop{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));left:10px;right:10px;display:flex;justify-content:space-between;align-items:center;z-index:2;font-size:15px}
#htop span{background:#0009;padding:6px 12px;border-radius:14px}
#htop button{width:auto;margin:0;padding:6px 12px;font-size:13px;border-radius:14px}
#hbar{position:absolute;left:0;right:0;bottom:0;padding:10px 10px calc(14px + env(safe-area-inset-bottom,0px));display:flex;justify-content:center;gap:10px;background:linear-gradient(transparent,#000d);z-index:2}
#hbar button{flex:1;max-width:96px;margin:0;padding:10px 0;background:transparent;color:#d8cbb8;font-size:13px;border-radius:12px}
#hbar button.main{color:#fff;font-size:15px;font-weight:700;background:radial-gradient(circle,#c3381f88,transparent 70%)}
#panel{position:fixed;inset:0;z-index:13;display:none;overflow:auto;background:#000d;color:#f3ecd8;padding:calc(20px + env(safe-area-inset-top,0px)) 16px 24px}
#panel .box{max-width:400px;margin:0 auto;text-align:center}
#panel button{width:100%;margin:6px 0;padding:14px;font-size:15px}
#panel button.s{background:#ffffff1f;color:#f3ecd8}
#panel button:disabled{opacity:.45}
#panel small{opacity:.75}
#panel .sp{width:30px;margin:0 auto}
#panel h3{margin:4px 0}
/* 전투 연출 및 레벨업 패널 강화 */
#panel .level-card{background:linear-gradient(135deg,#35234fdd,#151522ee);border:1px solid #d8b76a88;border-radius:14px;padding:14px;margin:10px 0;box-shadow:0 8px 28px #0007}
#panel .level-title{color:#ffd978;font-size:19px;font-weight:800;text-shadow:0 0 14px #ffb52f88}
#panel button.level-hero{background:linear-gradient(110deg,#7953bb,#b77c32);border:1px solid #ffe3a0;color:#fff;box-shadow:0 3px 14px #0005}
#info{border:1px solid #ffffff18;box-shadow:inset 0 1px #ffffff0a}
@keyframes levelGlow{0%,100%{box-shadow:0 0 8px #ffc85733}50%{box-shadow:0 0 24px #ffc85799}}
#panel .level-card{animation:levelGlow 2s ease-in-out infinite}
</style>
</head>
<body>
<div id="app">
<h1>⚔️ 판타지 SRPG</h1>
<div id="board"></div>
<div id="info"></div>
<div id="bar"><button class="s" id="skb">스킬</button><button class="s" id="dfb">방어</button><button class="s" id="wait">대기</button><button id="end">턴 종료</button></div>
</div>
<div id="start"><div class="box">
<div class="logo">⚔️</div>
<h2>판타지 SRPG</h2>
<p>영웅 레온과 소환한 동료들로 오크 무리를 물리쳐라</p>
<button id="go">게임 시작</button>
<button class="s" id="gb">🔮 소환 / 파티 편성</button>
<button class="s" id="hb">게임 방법</button>
<div id="how">1. 내 유닛을 터치해 이동 범위(파랑) 확인<br>2. 파란 칸을 터치해 이동<br>3. 빨간 적을 터치해 공격 (또는 대기)<br>4. 모두 행동하면 턴 종료<br>5. 적을 전멸시키면 승리!</div>
</div></div>
<div id="story"><div class="sb"><div id="se"></div><p id="st"></p><button id="sn">다음</button><button class="s" id="sk">건너뛰기</button></div></div>
<div id="hub"><div class="box"><h2>🏰 거점</h2><div id="hg" style="margin-bottom:10px;font-size:18px"></div><div id="sl"></div><button class="s" id="hgc">🔮 소환 / 파티 편성</button><button class="s" id="hbk">타이틀로</button></div></div>
<div id="panel"><div class="box"><h2 id="pt"></h2><div id="pc"></div><button class="s" id="pk">닫기</button></div></div>
<div id="gacha"><div class="box">
<h2>🔮 영웅 소환</h2>
<div id="gm"></div>
<button id="pull">1회 소환 (💎100)</button>
<div id="pr"></div>
<div class="ph">보유 영웅 · 탭해서 파티 편성 (최대 2명)</div>
<div id="roster"></div>
<button class="s" id="gx">돌아가기</button>
</div></div>
<div id="msg"><div><span id="mt"></span><br><button onclick="init()">다시 시작</button><button class="s" onclick="menu()">메인 메뉴</button></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
let N=8;
const WALLS=new Set(["3,2","3,3","4,5","4,6","1,4"]);
let U,turn,sel,mode,moves,atks,over;
const $=s=>document.querySelector(s);
const B=$("#board");

function init(){
  U=[
    {n:"기사",e:"🛡️",x:1,y:6,hp:30,mhp:30,atk:9,mv:3,rng:1,team:0},
    {n:"궁수",e:"🏹",x:3,y:7,hp:20,mhp:20,atk:8,mv:3,rng:3,team:0},
    {n:"마법사",e:"🧙",x:5,y:7,hp:18,mhp:18,atk:11,mv:2,rng:2,team:0},
    {n:"오크",e:"👹",x:2,y:0,hp:26,mhp:26,atk:8,mv:3,rng:1,team:1},
    {n:"고블린",e:"👺",x:5,y:1,hp:16,mhp:16,atk:6,mv:4,rng:1,team:1},
    {n:"해골궁수",e:"💀",x:6,y:0,hp:18,mhp:18,atk:7,mv:3,rng:3,team:1}
  ];
  U=stageEnemies().concat(partyUnits());U.forEach(u=>{u.done=false;u.ap=10});turn=0;sel=null;mode=null;over=false;moves=[];atks=[];
  $("#msg").style.display="none";
  info("유닛을 터치해 선택하세요.");
  draw();
}
const at=(x,y)=>U.find(u=>u.hp>0&&u.x==x&&u.y==y);
const wall=(x,y)=>WALLS.has(x+","+y)||VOID.has(x+","+y);
const dist=(a,b)=>Math.abs(a.x-b.x)+Math.abs(a.y-b.y);
function info(t){$("#info").innerHTML=t}

function reach(u){
  const r=[],q=[[u.x,u.y,0]],seen=new Set([u.x+","+u.y]);
  while(q.length){
    const [x,y,d]=q.shift();r.push({x,y});
    if(d==u.mv)continue;
    for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){
      const nx=x+dx,ny=y+dy,k=nx+","+ny;
      if(nx<0||ny<0||nx>=N||ny>=N||wall(nx,ny)||seen.has(k))continue;
      const o=at(nx,ny);if(o&&o.team!=u.team)continue;
      seen.add(k);q.push([nx,ny,d+1]);
    }
  }
  return r.filter(p=>!at(p.x,p.y)||(p.x==u.x&&p.y==u.y));
}
function targets(u){return U.filter(o=>o.hp>0&&o.team!=u.team&&dist(u,o)<=u.rng)}

function drawOld(){
  B.innerHTML="";
  for(let y=0;y<N;y++)for(let x=0;x<N;x++){
    const d=document.createElement("div");
    d.className="t "+(wall(x,y)?"w":((x+y)%2?"a":"b"));
    if(wall(x,y))d.textContent="🪨";
    if(moves.some(p=>p.x==x&&p.y==y))d.classList.add("mv");
    if(atks.some(o=>o.x==x&&o.y==y))d.classList.add("at");
    if(sel&&sel.x==x&&sel.y==y)d.classList.add("sel");
    const u=at(x,y);
    if(u){
      d.classList.add("u");if(u.team)d.classList.add("foe");
      if(u.done&&!u.team)d.classList.add("done");
      d.innerHTML=ico(u.e)+'<div class="hp"><i style="width:'+(u.hp/u.mhp*100)+'%"></i></div>';
    }
    d.onclick=()=>tap(x,y);
    B.appendChild(d);
  }
}

function tapOld(x,y){
  if(over||turn!=0)return;
  const u=at(x,y);
  if(mode=="move"&&moves.some(p=>p.x==x&&p.y==y)){
    sel.x=x;sel.y=y;moves=[];
    afterMove();return;
  }
  if(mode=="attack"){
    if(u&&atks.includes(u)){hit(sel,u);finish(sel);return;}
    return;
  }
  if(u&&u.team==0&&!u.done){
    sel=u;mode="move";moves=reach(u);atks=[];
    info(`<b>${u.n}</b> HP ${u.hp}/${u.mhp} · 공격 ${u.atk} · 이동 ${u.mv} · 사거리 ${u.rng}<br>파란 칸으로 이동하세요.`);
    draw();
  }else if(u&&u.team==1){
    info(`<b>${u.n}</b> (적) HP ${u.hp}/${u.mhp} · 공격 ${u.atk} · 사거리 ${u.rng}`);
  }
}
function afterMove(){
  atks=targets(sel);
  if(atks.length){mode="attack";info("공격할 적을 터치하세요. (대기: 행동 종료)")}
  else{info("공격 가능한 적이 없습니다. 대기를 누르세요.");mode="attack"}
  draw();
}
function hitOld(a,d){
  const dmg=Math.max(1,a.atk+Math.floor(Math.random()*3)-1);
  d.hp=Math.max(0,d.hp-dmg);
  info(`${a.n}의 공격! ${d.n}에게 ${dmg} 피해`+(d.hp==0?" — 쓰러뜨렸다!":""));
}
function finish(u){
  u.done=true;sel=null;mode=null;moves=[];atks=[];
  draw();check();
}
function check(){
  const p=U.some(u=>u.team==0&&u.hp>0),e=U.some(u=>u.team==1&&u.hp>0);
  if(!e)return end("🏆 승리!");
  if(!p)return end("☠️ 패배...");
}
function end(t){over=true;const w0=t.includes("승리");G.gems+=w0?STAGES[CUR].gem:30;G.gold=(G.gold||0)+(w0?STAGES[CUR].gem:20);if(w0)G.clr=Math.max(G.clr||0,CUR+1);save();const w=t.includes("승리");$("#mt").innerHTML=t+'<small style="display:block;font-size:13px;opacity:.85;margin-top:10px;line-height:1.6">'+(w?"오크 무리는 물러갔고, 실버리프 마을에 다시 평화가 찾아왔다.<br>그러나 먼 북쪽에서 더 큰 어둠이 꿈틀거리고 있었으니…":"영웅들은 쓰러졌지만, 마을 사람들의 희망은 꺼지지 않았다.<br>다시 일어설 때다.")+'</small>';$("#msg").style.display="flex"}

$("#wait").onclick=()=>{if(sel&&!over&&turn==0)finish(sel)};
$("#end").onclick=()=>{
  if(over||turn!=0)return;
  sel=null;mode=null;moves=[];atks=[];turn=1;draw();
  info("적의 턴...");
  setTimeout(enemyTurn,500);
};

async function enemyTurn(){
  for(const e of U.filter(u=>u.team==1&&u.hp>0)){
    if(over)return;
    const foes=U.filter(u=>u.team==0&&u.hp>0);
    if(!foes.length)break;
    let best=null;
    for(const p of reach(e)){
      for(const f of foes){
        const dm=Math.abs(p.x-f.x)+Math.abs(p.y-f.y),d=dm<=e.rng?dm:pdist(p,f);
        const can=d<=e.rng;
        const score=(can?100:0)-d+(can?(f.mhp-f.hp)*.1:0);
        if(!best||score>best.s)best={s:score,p,f,can};
      }
    }
    e.x=best.p.x;e.y=best.p.y;draw();
    await new Promise(r=>setTimeout(r,350));
    if(best.can){hit(e,best.f);draw();check();await new Promise(r=>setTimeout(r,450))}
  }
  if(over)return;
  U.forEach(u=>{if(u.team==0){u.done=false;u.ap=10;u.mvl=u.mv+2;u.def=false;passTurn(u);if(u.cd>0)u.cd--}});
  turn=0;draw();
  info("당신의 턴! 유닛을 선택하세요.");
}
function menu(){$("#msg").style.display="none";openHub()}
const INTRO=[["📜","엘데른 왕국 변경, 평화롭던 실버리프 마을에 검은 연기가 피어올랐다."],["👹","오크 무리가 마을을 습격했다. 전령이 피투성이로 달려와 도움을 청한다."],["🛡️","기사 레온: 내가 앞장선다. 더는 아무도 다치게 두지 않겠어."],["✨","레온은 홀로 길을 나섰다. 소환의 문이 열리면 동료들이 힘이 되어 줄 것이다."]];
function playStory(list,done){let i=0;const s=$("#story");s.style.display="flex";const show=()=>{$("#se").innerHTML=ico(list[i][0]);$("#st").textContent=list[i][1];$("#sn").textContent=i==list.length-1?"전투 시작":"다음"};show();$("#sn").onclick=()=>{if(++i>=list.length){s.style.display="none";done()}else show()};$("#sk").onclick=()=>{s.style.display="none";done()}}
$("#go").onclick=()=>{$("#start").style.display="none";if(!G.intro){G.intro=1;save();playStory(INTRO,openHub)}else openHub()};
let G={gems:600,own:{},party:[]};
try{const s=JSON.parse(localStorage.getItem("srpg1")||"null");if(s)G=s}catch(e){}
const save=()=>{try{localStorage.setItem("srpg1",JSON.stringify(G))}catch(e){}};
const STAR={3:"★★★",4:"★★★★",5:"★★★★★"};
const POOL=[
{id:"iris",n:"이리스",e:"🏹",r:3,hp:20,atk:8,mv:3,rng:3},
{id:"morgan",n:"모르간",e:"🧙",r:3,hp:18,atk:11,mv:2,rng:2},
{id:"kai",n:"카이",e:"🗡️",r:3,hp:20,atk:9,mv:4,rng:1},
{id:"elia",n:"엘리아",e:"🧝",r:4,hp:22,atk:11,mv:3,rng:4},
