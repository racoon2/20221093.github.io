 const row=k=>`<div style="display:flex;align-items:center;justify-content:space-between;background:#ffffff14;border-radius:10px;padding:8px 12px;margin:6px 0"><span>${STN[k][0]} <b>+${p[k]}</b> <small>(${STN[k][1]})</small></span><button data-k="${k}" ${p.pt>0?"":'class="s" disabled'} style="width:44px;margin:0;padding:8px">+</button></div>`;
 openPanel("📜 상태창",`<div style="display:flex;gap:6px;overflow:auto;margin-bottom:8px">${ids.map(i=>`<button data-h="${i}" ${i==id?"":'class="s"'} style="width:auto;flex:none;padding:8px 10px;margin:0">${ico(i=="leon"?"⚔️":POOL.find(h=>h.id==i).e)}</button>`).join("")}</div><h3>${b.n} Lv ${p.lv}</h3><small>경험치 ${p.xp}/${need(p.lv)} · 남은 포인트 <b>${p.pt}</b></small><div style="margin:6px 0"><small>HP ${c.hp} · 공격 ${c.atk} · 방어 ${c.df}</small></div>${row("hp")}${row("atk")}${row("df")}<div style="text-align:left;background:#ffffff14;border-radius:10px;padding:10px 12px;margin:8px 0;font-size:14px;line-height:1.6"><b>액티브 · ${s.n}</b><br>피해 x${s.m}, 사거리 +${s.rb}${s.sp?", 주변 확산":""} · AP 5 · 쿨 ${id=="morgan"?2:3}턴<br><b>패시브 · ${ps[0]}</b><br>${ps[1]}</div>`);
 document.querySelectorAll("#pc button[data-h]").forEach(x=>x.onclick=()=>statusPanel(x.dataset.h,Array.isArray(allowedIds)?ids:null));
 document.querySelectorAll("#pc button[data-k]").forEach(x=>x.onclick=()=>{
  if(p.pt<=0)return;p.pt--;p[x.dataset.k]++;
  const u=PARTY.find(q=>q.pid==id);if(u)rebuild(u);
  save();statusPanel(id)})}
function hubAct(a){
 if(a=="exp")panelStages();
 else if(a=="shop")shopPanel();
 else if(a=="inn")innPanel();
 else if(a=="st")statusPanel();
 else if(a=="gacha"){$("#gacha").style.display="block";$("#pr").textContent="";rg()}}
function openHub(){
 $("#hub").style.display="block";hubInit();
 if(!$("#hbar [data-a=st]")){const b=document.createElement("button");b.dataset.a="st";b.innerHTML="📜<br>상태";b.onclick=()=>hubAct("st");$("#hbar").appendChild(b)}
 hubRefresh();if(!H3loop){H3loop=1;hubLoop()}}
if(!$("#stb")){const b=document.createElement("button");b.className="s";b.id="stb";b.textContent="상태";b.onclick=()=>statusPanel();$("#bar").appendChild(b)}
const STY={iris:"bow",elia:"bow",morgan:"cast",seraph:"cast"};
const wp=u=>{const m=UM.get(u);return m?m.root.position.clone():new THREE.Vector3(u.x-3.5,.35,u.y-3.5)};
function trail(p,col){if(!S3)return;const m=new THREE.Mesh(new THREE.BoxGeometry(.06,.06,.06),new THREE.MeshBasicMaterial({color:col}));m.position.copy(p);S3.add(m);FXL.push({type:"p",m,t:0,life:10,v:new THREE.Vector3(0,.004,0)})}
function fxArc(d,col,sc){
 if(!S3)return;const p=wp(d);
 // 겹치는 두 개의 발광 참격 궤적과 충격 섬광
 for(let i=0;i<2;i++){
  const m=new THREE.Mesh(new THREE.TorusGeometry(.48+i*.13,.035+i*.012,8,28,Math.PI*(1.05+i*.18)),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.98,depthWrite:false}));
  m.position.set(p.x,p.y+.5+i*.13,p.z);m.rotation.set(.2+i*.35,Math.random()*3,Math.random()*3);m.scale.setScalar((.65+i*.12)*sc);S3.add(m);
  FXL.push({type:"x",m,t:0,life:16,fn:f=>{f.m.scale.setScalar((.55+f.t/16*1.15)*sc);f.m.material.opacity=1-f.t/16;f.m.rotation.z+=i?.32:-.38}})
 }
 fxRing(d,col,sc>1?1.5:.85);
 }
function fxRing(d,col,sz){
 if(!S3)return;const p=wp(d);
 const m=new THREE.Mesh(new THREE.RingGeometry(.2,.28,24),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.9,side:2}));
 m.rotation.x=-Math.PI/2;m.position.set(p.x,p.y+.06,p.z);S3.add(m);
 FXL.push({type:"x",m,t:0,life:16,fn:f=>{f.m.scale.setScalar(1+f.t*.22*sz);f.m.material.opacity=.9*(1-f.t/16)}})}
function fxDefense(u){
 if(!S3||!u)return;const p=wp(u),col=0x68caff;
 // 발밑 룬 원 + 위로 솟는 보호막 파동
 const ring=new THREE.Mesh(new THREE.RingGeometry(.38,.52,40),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.95,side:THREE.DoubleSide,depthWrite:false}));
 ring.rotation.x=-Math.PI/2;ring.position.set(p.x,p.y+.045,p.z);S3.add(ring);
 FXL.push({type:"x",m:ring,t:0,life:34,fn:f=>{f.m.scale.setScalar(1+f.t*.035);f.m.material.opacity=.95*(1-f.t/34)}});
 const shield=new THREE.Mesh(new THREE.SphereGeometry(.72,20,16,0,Math.PI*2,0,Math.PI*.72),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.3,wireframe:true,depthWrite:false}));
 shield.position.set(p.x,p.y+.65,p.z);S3.add(shield);
 FXL.push({type:"x",m:shield,t:0,life:28,fn:f=>{f.m.scale.setScalar(1+Math.sin(f.t/28*Math.PI)*.16);f.m.material.opacity=.34*(1-f.t/28);f.m.rotation.y+=.035}});
 for(let i=0;i<10;i++){const a=i*Math.PI*2/10;const q=new THREE.Vector3(p.x+Math.cos(a)*.45,p.y+.15+(i%3)*.16,p.z+Math.sin(a)*.45);trail(q,col)}
}
function fxCharge(a,col){
 if(!S3)return;const p=wp(a);
 const m=new THREE.Mesh(new THREE.SphereGeometry(.3,10,8),new THREE.MeshBasicMaterial({color:col,transparent:true,opacity:.8}));
 m.position.set(p.x,p.y+1.1,p.z);S3.add(m);
 FXL.push({type:"x",m,t:0,life:14,fn:f=>{f.m.scale.setScalar(.15+f.t/14*.9);f.m.material.opacity=.85*(1-f.t/18);if(f.t%3==0)trail(f.m.position,col)}})}
function fxProj(a,d,kind,col,delay,n){
 if(!S3)return;
 setTimeout(()=>{
  const s=wp(a),e=wp(d);s.y+=.8;e.y+=.6;
  for(let k=0;k<(n||1);k++){
   const m=kind=="arrow"?new THREE.Mesh(new THREE.BoxGeometry(.04,.04,.5),new THREE.MeshBasicMaterial({color:"#e8d8a8"})):new THREE.Mesh(new THREE.SphereGeometry(kind=="orb2"?.28:.18,16,12),new THREE.MeshBasicMaterial({color:col}));
   const off=(k-((n||1)-1)/2)*.5;m.position.copy(s);S3.add(m);
   FXL.push({type:"x",m,t:0,life:14,fn:f=>{
    const q=f.t/14;
    f.m.position.set(s.x+(e.x-s.x)*q,s.y+(e.y-s.y)*q+Math.sin(q*Math.PI)*(.35+off*.4),s.z+(e.z-s.z)*q);
    if(kind=="arrow")f.m.lookAt(e.x,e.y,e.z);
    if(f.t%2==0)trail(f.m.position,col)}})}
 },delay)}
function reachAP(u){
 const lim=Math.min(u.ap,u.mvl==null?u.mv+2:u.mvl),r=[],q=[[u.x,u.y,0]],seen=new Set([u.x+","+u.y]);
 while(q.length){
  const [x,y,d]=q.shift();
  if(!at(x,y)||(x==u.x&&y==u.y))r.push({x,y,d});
  if(d>=lim)continue;
  for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){
   const nx=x+dx,ny=y+dy,k=nx+","+ny;
   if(nx<0||ny<0||nx>=N||ny>=N||wall(nx,ny)||seen.has(k))continue;
   const o=at(nx,ny);if(o&&o.team!=u.team)continue;
   seen.add(k);q.push([nx,ny,d+1])}}
 return r}
function moveTo(x,y){
 const p=moves.find(q=>q.x==x&&q.y==y);if(!p)return;
 sel.ap-=p.d;sel.mvl=(sel.mvl==null?sel.mv+2:sel.mvl)-p.d;sel.x=x;sel.y=y;
 if(EXIT&&x==EXIT.x&&y==EXIT.y){turn=2;info("탈출구에 도착했다!");moves=[];atks=[];draw();setTimeout(()=>{if(!over)end("🏆 승리! 원정 성공 — 탈출!")},600);return}
 refresh(false)}
function refresh(keep){
 if(!sel)return;
 if(sel.ap<=0){finish(sel);return}
 moves=reachAP(sel);const s=skillOf(sel),ml=sel.mvl==null?sel.mv+2:sel.mvl;
 atks=sel.ap>=(skm?5:3)?tg(sel,skm):[];
 const ap=`AP ${sel.ap}/10`;
 if(keep)$("#info").innerHTML+=`<br>${ap} · 이동 ${ml}칸 남음`;
 else info(`<b>${sel.n}</b> HP ${sel.hp}/${sel.mhp} · ${ap} · 이동 ${ml}칸 남음 · 공격 ${sel.atk}<br>이동 1AP/칸(턴당 이동량 제한) · 공격 3 · 스킬 5(${s.n}${sel.cd>0?", 쿨 "+sel.cd+"턴":""}) · 방어 2`);
 draw()}
function anim(m,u,mvd){
 const P=m.parts,t=Date.now()/1000,sw=mvd>.06?Math.sin(t*12)*.7:0,id=Math.sin(t*2+u.x+u.y)*.05;
 let al=-sw*.7+id,ar=sw*.7-id,hz=0,ln=0;
 if(u.lg>0){
  const p=1-u.lg/(u.lt||16),st=u.st||"melee";
  if(st=="melee"){
   if(p<.3){ar=-2.9*(p/.3);al=.3;ln=-.12*(p/.3)}
   else if(p<.55){const q=(p-.3)/.25;ar=-2.9+3.5*q;al=.4;ln=-.12+.4*q}
   else{const q=(p-.55)/.45;ar=.6*(1-q);al=.4*(1-q);ln=.28*(1-q)}
  }else if(st=="bow"){
   if(p<.55){const q=p/.55;ar=-1.55;al=-1.5+.2*q;hz=-.1*q;ln=-.05*q}
   else{const q=(p-.55)/.45;ar=-1.55*(1-q);al=-1.3*(1-q);ln=.1*(1-q)}
  }else{
   const q=Math.sin(p*Math.PI);al=-2.4*q;ar=-2.4*q;hz=-.25*q;ln=-.1*q}
 }
 if(u.def&&u.hp>0){al=-1.3;ar=-1.3}
 if(u.fx>0)hz=-.3;
 if(P.lL)P.lL.rotation.x=sw;if(P.lR)P.lR.rotation.x=-sw;
 if(P.aL)P.aL.rotation.x=al;if(P.aR)P.aR.rotation.x=ar;
 if(P.hd)P.hd.rotation.x=hz;
 if(P.tr)P.tr.scale.y=1+Math.sin(t*2.4)*.012;
 m.model.rotation.x=ln+(u.fx>0?-.15:0)}
function hit(a,d,m,q){
 m=m||1;let dm=a.atk+Math.floor(Math.random()*3)-1;
 if(a.pid=="iris"&&dist(a,d)>=2)dm*=1.2;
 if(a.pid=="kai"&&d.hp>=d.mhp)dm*=1.5;
 dm=Math.max(1,Math.round(dm*m));
 let rd=d.df||0;if(d.pid=="leon"&&d.hp<=d.mhp/2)rd+=2;if(d.pid=="barkan")rd+=2;
 dm=Math.max(1,dm-rd);
 if(d.def)dm=Math.max(1,Math.ceil(dm/2));
 const st=(a.pid&&STY[a.pid])||(a.n=="해골궁수"?"bow":"melee"),sk=m>1,col=sk?(SC[a.n]||0xffffff):0xffdd55;
 const imp=st=="melee"?150:st=="bow"?470:520,fr=st=="melee"?9:st=="bow"?28:31;
 d.hp=Math.max(0,d.hp-dm);d.fxw=fr;
 if(d.hp<=0&&a.pid=="fenrir"&&!q)a.ap=Math.min(10,(a.ap||0)+3);
 if(!q&&a!==d){
  const dx=d.x-a.x,dz=d.y-a.y,l=Math.hypot(dx,dz)||1;a.lx=dx/l;a.lz=dz/l;a.st=st;a.lt=st=="melee"?20:26;a.lg=a.lt;
  if(st=="melee")burst(a,0x9a8a78,5);
  if(st=="cast")fxCharge(a,col);
  if(st=="bow")fxProj(a,d,"arrow",col,230,sk?3:1);
  if(st=="cast")fxProj(a,d,sk?"orb2":"orb",col,260,1);
  setTimeout(()=>{shk=sk?12:5},imp)}
 setTimeout(()=>{
  if(st=="melee")fxArc(d,col,sk?1.6:1);
  burst(d,col,sk?28:14);popup(d,dm);
  if(sk||st!="melee")fxRing(d,col,sk?1.8:1.05);
  if(sk){fxArc(d,col,1.35);fxCharge(d,col)}
  if(sk&&st=="melee")fxRing(d,col,1.8)},imp);
 if(!q)info(`${a.n}의 ${sk?skillOf(a).n:"공격"}! ${d.n}에게 ${dm} 피해`+(d.def?" (방어로 경감)":"")+(d.hp==0?" — 쓰러뜨렸다!":""))}
$(".logo").innerHTML=ico("⚔");
$("#hb").onclick=()=>{const h=$("#how");h.style.display=h.style.display=="block"?"none":"block"};
init();
</script>
